<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sair"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5ED"
    tools:context=".problemasActivity">

    <TextView
        android:id="@+id/textView11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Principais problemas"
        android:textColor="#2F6B4F"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollProblemas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="24dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/continuar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView11">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/saude"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="#2F6B4F"
                android:text="SAÚDE"
                android:textColor="#1E3028"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/educacao"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="#2F6B4F"
                android:text="EDUCAÇÃO"
                android:textColor="#1E3028"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/transporte"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="#2F6B4F"
                android:text="TRANSPORTE"
                android:textColor="#1E3028"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/violencia"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="#2F6B4F"
                android:text="VIOLÊNCIA"
                android:textColor="#1E3028"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/corrupcao"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="#2F6B4F"
                android:text="CORRUPÇÃO"
                android:textColor="#1E3028"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/desemprego"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="#2F6B4F"
                android:text="DESEMPREGO"
                android:textColor="#1E3028"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/industrializacao"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="#2F6B4F"
                android:text="INDUSTRIALIZAÇÃO"
                android:textColor="#1E3028"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/seguranca"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="#2F6B4F"
                android:text="SEGURANÇA"
                android:textColor="#1E3028"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/moradia"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="#2F6B4F"
                android:text="MORADIA"
                android:textColor="#1E3028"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/meioambiente"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="#2F6B4F"
                android:text="MEIO AMBIENTE"
                android:textColor="#1E3028"
                android:textSize="16sp" />

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/continuar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#84CF82"
        android:text="CONTINUAR"
        android:textColor="#1E3028"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>