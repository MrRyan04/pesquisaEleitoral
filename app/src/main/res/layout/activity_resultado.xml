<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sair"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5ED"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    tools:context=".resultadoActivity">

    <TextView
        android:id="@+id/textView12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:text="PESSOAS ENTREVISTADAS"
        android:textColor="#2F6B4F"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/pessoasentrevistadas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#1E3028"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView12" />

    <Button
        android:id="@+id/eleitores"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="44dp"
        android:backgroundTint="#84CF82"
        android:text="ELEITORES"
        android:textColor="#1E3028"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pessoasentrevistadas" />

    <Button
        android:id="@+id/resultado"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#84CF82"
        android:text="RESULTADO"
        android:textColor="#1E3028"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/eleitores" />

    <Button
        android:id="@+id/limpar"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#2F6B4F"
        android:text="LIMPAR DADOS"
        android:textColor="#F7F5ED"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/resultado" />

    <Button
        android:id="@+id/sairresultados"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#2F6B4F"
        android:text="SAIR"
        android:textColor="#F7F5ED"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/limpar" />


</androidx.constraintlayout.widget.ConstraintLayout>