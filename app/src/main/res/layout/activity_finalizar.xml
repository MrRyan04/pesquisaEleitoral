<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sair"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5ED"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    tools:context=".finalizarActivity">

    <TextView
        android:id="@+id/dentrevistados"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Dados do entrevistado"
        android:textColor="#2F6B4F"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView13"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:text="Nome"
        android:textColor="#2F6B4F"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dentrevistados" />

    <EditText
        android:id="@+id/nomeentrevistado"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#2F6B4F"
        android:hint="Digite o nome"
        android:inputType="textPersonName"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="#1E3028"
        android:textColorHint="#8A9A91"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView13" />

    <TextView
        android:id="@+id/textView14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Telefone"
        android:textColor="#2F6B4F"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nomeentrevistado" />

    <EditText
        android:id="@+id/telefoneentrevistado"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#2F6B4F"
        android:hint="Digite o telefone"
        android:inputType="phone"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="#1E3028"
        android:textColorHint="#8A9A91"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView14" />

    <Button
        android:id="@+id/finalizar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="48dp"
        android:backgroundTint="#84CF82"
        android:text="FINALIZAR"
        android:textColor="#1E3028"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/telefoneentrevistado" />


</androidx.constraintlayout.widget.ConstraintLayout>